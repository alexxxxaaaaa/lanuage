# Large media files — hosted via R2 / static server rather than shipped in git.
# Keep .srt subtitle files (small text) but exclude .mp3.
client/public/exam-media/*.mp3
client/public/podcast-media/*.mp3
client/public/exam-media/*.wav
client/public/podcast-media/*.wav

# Generated SQL from ingestGrammarQuestions script
server/data/grammarQuestions/_generated_insert.sql

# 题库 → D1 的分片 SQL 与 R2 上传断点记录，都能从 n1-qbank/markdown 重新生成
server/d1_qbank/
server/.qbank-upload.log

# N1 真题源文件（PDF/图片体积过大，不入库；仅提交 N1/整理/ 下的题库 md）
N1/**/*.pdf
N1/**/*.png
N1/**/.DS_Store

# n1-qbank 全部入 git，包括听力音频（约 1.6 GB / 931 个 mp3）。
# 有意为之：题库要自包含，不依赖 R2 等外部存储的可用性。
# 注意最大单文件 2025.12/full.mp3 约 64 MB，超过 GitHub 50 MB 的警告线（未超 100 MB 硬限制）。
