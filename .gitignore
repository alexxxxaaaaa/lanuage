# Build artifacts
server/tsconfig.tsbuildinfo

# Wiktextract 原始 dump（共约 273 MB）——可由 npm run build:dict 重新下载。
# 抽取产物 server/data/dict/*.jsonl.gz 是入 git 的（gzip 后 42.9 MB，不走 LFS）。
server/.dictcache/

# Large media files — hosted via R2 / static server rather than shipped in git.
# Keep .srt subtitle files (small text) but exclude .mp3.
client/public/exam-media/*.mp3
client/public/podcast-media/*.mp3
client/public/exam-media/*.wav
client/public/podcast-media/*.wav

# Generated SQL from ingestGrammarQuestions script
server/data/grammarQuestions/_generated_insert.sql

# 题库 → D1 的分片 SQL 与 R2 上传断点记录，都能从 n1-qbank/markdown 重新生成
server/d1_qbank/
server/.qbank-upload.log

# 词库 → D1 的分片 SQL（406 片 / 222 MB），由 npm run import:dict -- --d1
# 从 server/data/dict/*.jsonl.gz 重新生成，源数据已入 git，不必再存一份。
server/d1_dict/

# N1 真题源文件（PDF/图片体积过大，不入库；仅提交 N1/整理/ 下的题库 md）
N1/**/*.pdf
N1/**/*.png
N1/**/.DS_Store

# 听力音频（1073 个 mp3 / 1.8 GB）曾经入 git，后来把仓库撑到 1.2 GB，
# 已用 git filter-repo 从全部历史里剔除。现在只走 R2 分发（uploadQbankMedia.sh），
# 生产数据是 D1 的 QbankQuestion.audio + R2 对象，md 里的 `- audio:` 路径照旧。
# 本地要重新抓可以跑 server/scripts/nadou/fetch_audio.py，抓下来别再提交。
n1-qbank/audio/

# hypertranscript：config.json 含 OpenAI key，不能进。
hypertranscript/config.json
hypertranscript/.transcript-upload.log

# 转写产物只入 json 那一份。它是花了约 $16、跑了 25 分钟的 OpenAI 调用换来的，
# 丢了就得重花一次，而且换台机器入库也要靠它 —— 1043 条压缩后约 3 MB，值。
# 另外两份都是从它派生的，别再占一遍体积，换机器跑一条命令就能重出：
#   npm start -- --render-only     重出 html 片段和预览页
#   npm run export:r2              重出 dist-r2（上传 R2 用的精简格式）
hypertranscript/output/**/*.html
hypertranscript/dist-r2/
