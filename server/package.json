{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.all.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "reviews:backfill": "node --import tsx scripts/backfillMissingReviews.ts",
    "export:sqlite-to-d1-sql": "node --import tsx scripts/exportSqliteToD1Sql.ts",
    "import:words": "node --import tsx scripts/importWordsToCloud.ts",
    "import:qbank": "node --import tsx scripts/importQbank.ts",
    "build:dict": "node --import tsx scripts/buildDict.ts",
    "import:dict": "node --import tsx scripts/importDict.ts",
    "export:qbank-d1-sql": "node --import tsx scripts/exportQbankD1Sql.ts",
    "upload:qbank-media": "bash scripts/uploadQbankMedia.sh",
    "extract:n1-pdf": "python3 scripts/extractN1Pdf.py",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy": "wrangler deploy",
    "d1:schema:apply:remote": "wrangler d1 execute word-sprint-db --remote --file=./prisma/migrations/20260508113011_init/migration.sql",
    "d1:schema:apply:local": "wrangler d1 execute word-sprint-db --local --file=./prisma/migrations/20260508113011_init/migration.sql",
    "d1:seed:remote": "wrangler d1 execute word-sprint-db --remote --file=./d1_seed.sql"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "pinyin-pro": "^3.28.2",
    "prisma": "^7.9.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.90.0"
  }
}
