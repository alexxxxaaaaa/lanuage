PORT=3000

# Local development uses SQLite. Optional — defaults to file:./prisma/dev.db.
# Since Prisma 7 this path resolves against server/ (the CWD of the dev server
# and of the scripts), not against prisma/schema.prisma as it did before.
DATABASE_URL="file:./prisma/dev.db"

# Required for auth — generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Required for AI features.
# Overriding OPENAI_MODEL only prices correctly for models listed in
# server/src/config/aiPricing.ts — anything else shows up as "unpriced" on
# the usage card rather than being billed at zero.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-luna"

# Optional: daily AI token cap per user (default 50000)
# DAILY_AI_TOKEN_BUDGET=50000

# 后台管理员用户名（逗号分隔，小写），命中的账号登录后可访问 /api/admin/*
# 建号只走管理后台（POST /api/admin/users），公开注册接口已下线。
ADMIN_USERNAMES="zyd"

# CORS 白名单（逗号分隔，带协议、不带尾斜杠）。留空 = 放行所有来源；
# localhost / 127.0.0.1 的任意端口无论如何都放行，所以本地开发不用设。
# ALLOWED_ORIGINS="https://lgstudy.com,https://www.lgstudy.com"

