generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  canSeePodcast     Boolean            @default(false)
  createdAt         DateTime           @default(now())
  folders           Folder[]
  notes             Note[]
  expressionFolders ExpressionFolder[]
  aiUsageLogs       AiUsageLog[]
  grammars          Grammar[]
  podcasts          Podcast[]
  exams             Exam[]
}

model Folder {
  id       String @id @default(uuid())
  name     String
  language String
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  words    Word[]

  @@index([userId])
}

model Word {
  id           String   @id @default(uuid())
  word         String
  reading      String
  meaning      String
  example      String
  note         String
  partOfSpeech String   @default("")
  language     String
  folderId     String
  sourceNoteId String?
  isPinned     Boolean  @default(false)
  pinnedAt     DateTime?
  folder       Folder   @relation(fields: [folderId], references: [id])
  sourceNote   Note?    @relation(fields: [sourceNoteId], references: [id])
  review       Review?
  createdAt    DateTime @default(now())

  @@unique([folderId, word])
  @@index([folderId, isPinned, pinnedAt])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  course    String   @default("")
  lesson    String   @default("")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  words     Word[]

  @@index([userId])
}

model Review {
  id              String    @id @default(uuid())
  wordId          String    @unique
  word            Word      @relation(fields: [wordId], references: [id])
  interval        Int       @default(1)
  repetition      Int       @default(0)
  easeFactor      Float     @default(2.5)
  difficultyScore Int       @default(0)
  lastRating      String    @default("")
  recentRatings   String    @default("")
  firstLearnedAt  DateTime?
  nextReviewDate  DateTime
  lastReviewedAt  DateTime?
}

model AiUsageLog {
  id               String   @id @default(uuid())
  word             String
  language         String
  model            String
  feature          String   @default("other")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())
  userId           String
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Expression {
  id         String           @id @default(uuid())
  zhText     String
  enCasual   String
  jpCasual   String
  sceneTag   String           @default("")
  note       String
  isMastered Boolean          @default(false)
  folderId   String
  folder     ExpressionFolder @relation(fields: [folderId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ExpressionFolder {
  id          String       @id @default(uuid())
  name        String
  language    String
  expressions Expression[]
  createdAt   DateTime     @default(now())
  userId      String
  user        User         @relation(fields: [userId], references: [id])

  @@unique([name, language, userId])
  @@index([userId])
}

model Grammar {
  id          String   @id @default(uuid())
  pattern     String
  connection  String   @default("")
  meaning     String   @default("")
  example     String   @default("")
  exampleZh   String   @default("")
  note        String   @default("")
  level       String   @default("N1")
  isPinned    Boolean  @default(false)
  pinnedAt    DateTime?
  isLearned   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  review      GrammarReview?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, pattern])
  @@index([userId])
  @@index([level])
  @@index([userId, pinnedAt])
}

model GrammarReview {
  id              String    @id @default(uuid())
  grammarId       String    @unique
  grammar         Grammar   @relation(fields: [grammarId], references: [id])
  interval        Int       @default(1)
  repetition      Int       @default(0)
  easeFactor      Float     @default(2.5)
  difficultyScore Int       @default(0)
  lastRating      String    @default("")
  recentRatings   String    @default("")
  firstLearnedAt  DateTime?
  nextReviewDate  DateTime
  lastReviewedAt  DateTime?
}

model Podcast {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  youtubeId   String
  title       String
  primaryLang String   @default("jp")
  thumbnail   String   @default("")
  durationSec Int      @default(0)
  // JSON-serialized transcript:
  //   { lines: [{ start: ms, dur: ms, text: string, zh?: string }] }
  transcript      String
  lastPositionSec Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@unique([userId, youtubeId])
}

// A JLPT-style real exam (真题). Phase 1: users upload a question PDF, we
// parse it with the AI into a structured `parsedData` blob and let them
// browse the questions. Phase 2+ adds answers (from a separate solution PDF),
// interactive answering, listening audio, etc. Assets other than the parsed
// JSON (the original PDF and audio) live in external storage (R2) — we only
// keep URLs here.
model Exam {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  title          String            // "N1 2019年7月"
  year           String   @default("")
  level          String   @default("N1")
  // Optional URLs to external assets; empty when not yet uploaded.
  questionPdfUrl String   @default("")
  solutionPdfUrl String   @default("")
  audioUrl       String   @default("")
  // JSON blob:
  //   { sections: [{ type, instruction, questions: [{ id, stem, target, choices, answer, explanation }] }] }
  parsedData     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempts       ExamAttempt[]

  @@index([userId])
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id])
  userId      String
  // JSON: { [questionId: number]: userAnswer: number }
  answers     String    @default("{}")
  score       Int?
  // JSON: { [sectionType]: correct/total }
  scoreByType String    @default("{}")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([examId])
  @@index([userId])
}
