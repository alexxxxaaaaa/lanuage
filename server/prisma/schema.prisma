generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection is supplied by the
// driver adapter in prisma.config.ts (CLI) and at PrismaClient construction
// (runtime). See src/lib/prisma.ts for the Node path and src/worker.ts for D1.
datasource db {
  provider = "sqlite"
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  folders           Folder[]
  notes             Note[]
  expressionFolders ExpressionFolder[]
  aiUsageLogs       AiUsageLog[]
  grammars          Grammar[]
  podcasts          Podcast[]
  reviewEvents      ReviewEvent[]
}

model Folder {
  id       String @id @default(uuid())
  name     String
  language String
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  words    Word[]

  @@index([userId])
}

model Word {
  id           String   @id @default(uuid())
  word         String
  reading      String
  meaning      String
  example      String
  note         String
  partOfSpeech String   @default("")
  language     String
  folderId     String
  sourceNoteId String?
  isPinned     Boolean  @default(false)
  pinnedAt     DateTime?
  folder       Folder   @relation(fields: [folderId], references: [id])
  sourceNote   Note?    @relation(fields: [sourceNoteId], references: [id])
  review       Review?
  createdAt    DateTime @default(now())

  @@unique([folderId, word])
  @@index([folderId, isPinned, pinnedAt])
}

model Note {
  id      String @id @default(uuid())
  /// 可以为空 —— 列表里显示成「无标题」，和 Notion 一样。
  title   String
  /// BlockNote 文档（`Block[]` 的 JSON）。老行可能还是 HTML 或更早的 Slate
  /// JSON，读的时候按格式分流，用户第一次编辑时才改写成 JSON，见
  /// `client/src/components/notes/noteContent.ts`。
  content String
  /// 课程标签。空串 = 未归类，不建单独的表，因为一条笔记只挂一个课程。
  course  String @default("")

  /// 课程时间。选填，创建时默认落成当下，所以业务上恒非空 —— 之所以在库里
  /// 是可空列，只是因为 SQLite 的 ALTER TABLE 加不了非常量默认值的 NOT NULL
  /// 列，迁移时只能先加可空列再回填。排序一律走这一列。
  lessonAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
  words  Word[]

  @@index([userId, lessonAt])
  @@index([userId, course])
}

model Review {
  id              String    @id @default(uuid())
  wordId          String    @unique
  word            Word      @relation(fields: [wordId], references: [id])
  interval        Int       @default(1)
  repetition      Int       @default(0)
  easeFactor      Float     @default(2.5)
  difficultyScore Int       @default(0)
  lastRating      String    @default("")
  recentRatings   String    @default("")
  firstLearnedAt  DateTime?
  nextReviewDate  DateTime
  lastReviewedAt  DateTime?
}

model AiUsageLog {
  id               String   @id @default(uuid())
  word             String
  language         String
  model            String
  feature          String   @default("other")
  // promptTokens is the whole prompt; the two cache columns are a breakdown of
  // it, not extras on top. Billing carves them out — see config/aiPricing.ts.
  promptTokens     Int      @default(0)
  cachedTokens     Int      @default(0)
  cacheWriteTokens Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())
  userId           String
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Expression {
  id         String           @id @default(uuid())
  zhText     String
  enCasual   String
  jpCasual   String
  sceneTag   String           @default("")
  note       String
  isMastered Boolean          @default(false)
  folderId   String
  folder     ExpressionFolder @relation(fields: [folderId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ExpressionFolder {
  id          String       @id @default(uuid())
  name        String
  language    String
  expressions Expression[]
  createdAt   DateTime     @default(now())
  userId      String
  user        User         @relation(fields: [userId], references: [id])

  @@unique([name, language, userId])
  @@index([userId])
}

model Grammar {
  id          String   @id @default(uuid())
  pattern     String
  connection  String   @default("")
  meaning     String   @default("")
  example     String   @default("")
  exampleZh   String   @default("")
  note        String   @default("")
  level       String   @default("N1")
  isPinned    Boolean  @default(false)
  pinnedAt    DateTime?
  isLearned   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  review      GrammarReview?
  questions   GrammarQuestion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, pattern])
  @@index([userId])
  @@index([level])
  @@index([userId, pinnedAt])
}

// N1-style four-choice questions attached to a Grammar row. Options are
// stored as a JSON-encoded string array of length 4; answerIndex is 0..3.
model GrammarQuestion {
  id          String   @id @default(uuid())
  grammarId   String
  grammar     Grammar  @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  prompt      String
  options     String
  answerIndex Int
  createdAt   DateTime @default(now())
  attempts    GrammarQuestionAttempt[]

  @@index([grammarId])
}

// One row per (user, question) attempt. Upserted on re-answer so the
// "wrong questions" view reflects the user's most recent attempt.
model GrammarQuestionAttempt {
  id            String   @id @default(uuid())
  userId        String
  questionId    String
  question      GrammarQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int
  isCorrect     Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, isCorrect])
}

model GrammarReview {
  id              String    @id @default(uuid())
  grammarId       String    @unique
  grammar         Grammar   @relation(fields: [grammarId], references: [id])
  interval        Int       @default(1)
  repetition      Int       @default(0)
  easeFactor      Float     @default(2.5)
  difficultyScore Int       @default(0)
  lastRating      String    @default("")
  recentRatings   String    @default("")
  firstLearnedAt  DateTime?
  nextReviewDate  DateTime
  lastReviewedAt  DateTime?
}

// ===== JLPT 精练题库（qbank）=====
//
// 全局共享的历年真题单题库（数据源 n1-qbank/markdown，见该目录 README）。
// 一套题两种用法：QbankExamAttempt 是「整卷计时模拟考」，
// QbankAttempt / QbankFavorite 是「按题型或年份拆开的单题精练」。
//
// 刻意不建 Paper 表：年份维度就是 (level, year, month) 三列，直接下沉到题目行上，
// 目录树的分组统计和练习集的排序/筛选因此全在单表内完成，不用 join。
// 題型名（漢字読み等）和大題指示语由 (category, mondaiNo) 唯一决定，
// 是前端常量（client/src/pages/jlpt/constants.ts），不入库。

model QbankPassage {
  id      String @id @default(uuid())
  level   String @default("N1")
  year    Int
  month   Int
  code    String // 卷内编号：P8-1 / P11 / PL1-1（听力原文）
  type    String @default("") // 内容理解（短文）等
  content String // 原文；情報検索的图片是 markdown 图片语法，路径相对媒体根

  questions QbankQuestion[]

  @@unique([level, year, month, code])
}

model QbankQuestion {
  id        String        @id @default(uuid())
  level     String        @default("N1")
  year      Int
  month     Int
  category  String // vocab | grammar | reading | listening
  mondaiNo  Int // 笔试 1–13；听力 1–5（category 内唯一）
  seq       String // 卷内展示题号：Q1 / 聴解1-1
  orderNo   Int // 卷内排序，听力从 1000 起，保证笔试在前
  stemJp    String        @default("")
  stemZh    String        @default("") // 笔试=中文翻译；听力=日文設問（源站如此）
  options   String        @default("[]") // JSON 字符串数组
  answer    Int // 1-based
  // 两来源（纳豆 / mojidict）答案不一致时，另一来源的答案，1-based；0 = 无分歧。
  // 官方答案无从查证，所以两个都判对，见 qbankService.isAcceptedAnswer。
  altAnswer Int           @default(0)
  // 分歧的人工争点说明，可为空 —— 「纳豆=4 / mojidict=2」那种话术前端按
  // answer/altAnswer 现算，不入库，免得多一份要跟着改的副本。
  disputeNote String      @default("")
  explain   String        @default("") // 逐选项解析；听力是原文+译文
  audioKey  String        @default("") // 相对媒体根，如 audio/2020.12/1-1.mp3
  source    String        @default("nadou") // nadou | mojidict
  passageId String?
  passage   QbankPassage? @relation(fields: [passageId], references: [id], onDelete: SetNull)

  attempts  QbankAttempt[]
  favorites QbankFavorite[]
  aiExplain QbankAiExplain?

  @@unique([level, year, month, seq])
  @@index([category, mondaiNo, year, month, orderNo])
  @@index([passageId])
}

// 一题一行，重做时覆盖 —— 答题卡和错题本都只关心「最近一次」的对错。
model QbankAttempt {
  id         String        @id @default(uuid())
  userId     String
  questionId String
  question   QbankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected   Int // 1-based
  isCorrect  Boolean
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, questionId])
  @@index([userId, isCorrect])
}

// AI 逐选项解析。题库是全局共享的，同一道题对谁都是同一份分析，所以缓存挂在题上、
// 不挂 (用户, 题)：第一个点的人付 token，之后所有人直接读。听力题不生成
// （它的 explain 本来就是原文+译文，题干在音频里）。
model QbankAiExplain {
  questionId String        @id
  question   QbankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  summary    String // 一句话点题
  options    String        @default("[]") // JSON 字符串数组，与选项一一对应
  model      String        @default("")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model QbankFavorite {
  id         String        @id @default(uuid())
  userId     String
  questionId String
  question   QbankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

// 模拟考试：一套真题的整卷作答。每套卷每人只留最近一次，「重置」= 删掉这一行。
// 刻意不碰 QbankAttempt —— 考试成绩与平时的答题卡/错题本互不干扰，
// 交卷后由用户主动「收错题」才写过去。
model QbankExamAttempt {
  id     String @id @default(uuid())
  userId String
  level  String @default("N1")
  year   Int
  month  Int
  // strict | self。开考时定格，中途改设置不影响进行中的这场。
  mode   String @default("strict")
  // JSON: { [questionId]: 1-based 选项 }
  answers String @default("{}")
  // JSON: 交卷时定格的成绩（ExamScore），列表页直接读，不必重算整卷。
  score   String @default("")
  // 三个时刻决定阶段：finishedAt → 已完成，writtenSubmittedAt → 听力中，都空 → 笔试中。
  startedAt          DateTime  @default(now())
  writtenSubmittedAt DateTime?
  finishedAt         DateTime?

  @@unique([userId, level, year, month])
}

model Podcast {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  // For YouTube podcasts this is the real videoId. For mp3 podcasts it's a
  // synthetic id like "mp3-<uuid>" so the (userId, youtubeId) unique
  // constraint still holds.
  youtubeId   String
  // Non-empty when this is a local/mp3-based podcast (served from the
  // frontend's public/ folder). Frontend switches player based on this.
  mp3Url      String   @default("")
  title       String
  primaryLang String   @default("jp")
  thumbnail   String   @default("")
  durationSec Int      @default(0)
  // JSON-serialized transcript:
  //   { lines: [{ start: ms, dur: ms, text: string, zh?: string }] }
  transcript      String
  lastPositionSec Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@unique([userId, youtubeId])
}

// Per-rating event log. Powers weekly-review analytics (how many words
// reviewed this week, correctness rate, etc). The Review row only holds
// FSRS *current* state, which is enough for scheduling but not for time-
// windowed analytics — we can't reconstruct "how many reviews did I do
// last Tuesday" from Review alone. One row per submitted rating.
model ReviewEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // 'word' | 'grammar' — same enum values on the client.
  kind      String
  itemId    String
  // 'again' | 'hard' | 'easy'
  rating    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
